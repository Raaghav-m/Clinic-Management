# Copy to .env and fill in values before running locally or with Docker Compose.
# Do not commit .env — it is gitignored.
#
# Docker Compose reads this file automatically from the project root.
# If `docker-compose config` still shows empty values, your shell may be
# overriding them — run: unset DB_PASSWORD DB_NAME DOCKERHUB_USERNAME MYSQL_ROOT_PASSWORD

# Docker Hub image namespace (production Compose pulls pre-built images)
DOCKERHUB_USERNAME=your_dockerhub_username

# Database — shared by Compose backend and local Spring dev profile
DB_NAME=clinic_db
DB_USERNAME=clinic_user
DB_PASSWORD=change_me

# MySQL root password (Compose mysql service only; do not use root as MYSQL_USER)
MYSQL_ROOT_PASSWORD=change_me_root

# Local Maven dev (dev profile uses DB_* above)
# Active Spring profile (dev for local Maven runs; Compose sets prod on backend)
SPRING_PROFILES_ACTIVE=dev

# JWT — must be a Base64-encoded secret key (JwtService decodes with Base64)
JWT_SECRET=
